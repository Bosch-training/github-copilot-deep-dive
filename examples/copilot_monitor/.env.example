# Copy to .env (git-ignored) to configure. Everything here is optional:
# without a key, or with JUDGE_ENABLED=false, the tool runs with no LLM judge
# and uses your own star ratings as the quality signal.
# Real environment variables take precedence over this file.

# Set to false to skip the LLM judge entirely (no key or model needed).
JUDGE_ENABLED=true

# Needed only when the judge is enabled. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Judge model. Pick one from a different family than the models you compare.
JUDGE_MODEL=openai/gpt-4o-mini
